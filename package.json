{
  "name": "dailo-app-basic-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build && npm run post-build",
    "build-dev": "tsc -b && vite build --mode dev && npm run post-build",
    "build-all": "npm run build && npm run build-dev",
    "post-build": "node ./build/post-build.cjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hookform/resolvers": "^7.0.6",
    "@reduxjs/toolkit": "^2.14.0",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.23",
    "i18next": "^27.1.3",
    "lucide-react": "^1.73.0",
    "marked": "^18.2.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.2",
    "react-redux": "^9.3.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
